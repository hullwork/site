{
  "name": "example-stack",
  "components": [
    {
      "name": "stack-web",
      "image": "nginxinc/nginx-unprivileged:1.29-alpine",
      "port": 8080,
      "healthPath": "/",
      "exposure": "public"
    },
    {
      "name": "stack-worker",
      "image": "nginxinc/nginx-unprivileged:1.29-alpine",
      "port": 8080,
      "healthPath": "/",
      "exposure": "internal"
    }
  ]
}
