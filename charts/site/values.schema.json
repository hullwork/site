{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "buildPlane",
    "clusterNetwork",
    "database",
    "existingSecrets",
    "gateway",
    "images",
    "localPathProvisioner",
    "mcpEndpoint",
    "monitoring",
    "namespaces",
    "postgresql",
    "service",
    "storage",
    "tracing"
  ],
  "properties": {
    "namespaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "gateway"
      ],
      "properties": {
        "control": {
          "type": "string",
          "minLength": 1
        },
        "gateway": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control",
        "postgres",
        "registry",
        "nginx",
        "prometheus",
        "localPathProvisioner",
        "busybox"
      ],
      "properties": {
        "control": {
          "$ref": "#/$defs/image"
        },
        "postgres": {
          "$ref": "#/$defs/image"
        },
        "registry": {
          "$ref": "#/$defs/image"
        },
        "nginx": {
          "$ref": "#/$defs/image"
        },
        "prometheus": {
          "$ref": "#/$defs/image"
        },
        "localPathProvisioner": {
          "$ref": "#/$defs/image"
        },
        "busybox": {
          "$ref": "#/$defs/image"
        }
      }
    },
    "service": {
      "$ref": "#/$defs/service"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storageClass"
      ],
      "properties": {
        "storageClass": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "localPathProvisioner": {
      "$ref": "#/$defs/feature"
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "embedded"
      ],
      "properties": {
        "embedded": {
          "$ref": "#/$defs/feature"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "runtimeHost",
        "port",
        "name",
        "user"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "runtimeHost": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "existingSecrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "database",
        "registry",
        "objectStorage"
      ],
      "properties": {
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "tokenKey",
            "consoleSessionKey"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/secretName"
            },
            "tokenKey": {
              "$ref": "#/$defs/secretKey"
            },
            "consoleSessionKey": {
              "$ref": "#/$defs/secretKey"
            }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "usernameKey",
            "databaseKey",
            "passwordKey"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/secretName"
            },
            "usernameKey": {
              "$ref": "#/$defs/secretKey"
            },
            "databaseKey": {
              "$ref": "#/$defs/secretKey"
            },
            "passwordKey": {
              "$ref": "#/$defs/secretKey"
            }
          }
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "passwordKey",
            "htpasswdKey"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/secretName"
            },
            "passwordKey": {
              "$ref": "#/$defs/secretKey"
            },
            "htpasswdKey": {
              "$ref": "#/$defs/secretKey"
            }
          }
        },
        "objectStorage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "accessKeyIdKey",
            "accessKeySecretKey"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/secretName"
            },
            "accessKeyIdKey": {
              "$ref": "#/$defs/secretKey"
            },
            "accessKeySecretKey": {
              "$ref": "#/$defs/secretKey"
            }
          }
        }
      }
    },
    "buildPlane": {
      "$ref": "#/$defs/feature"
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "serviceType"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "serviceType": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "httpNodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 30000,
          "maximum": 32767
        },
        "metricsNodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 30000,
          "maximum": 32767
        }
      }
    },
    "monitoring": {
      "$ref": "#/$defs/feature"
    },
    "mcpEndpoint": {
      "$ref": "#/$defs/feature"
    },
    "tracing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "endpoint",
        "queueSize",
        "batchSize",
        "flushSeconds",
        "timeoutSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string"
        },
        "queueSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "flushSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "timeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        }
      }
    },
    "clusterNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "podCIDR"
      ],
      "properties": {
        "podCIDR": {
          "type": "string",
          "description": "Pod network of the target cluster in CIDR notation. No default; an empty value fails the render.",
          "pattern": "^$|^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
        }
      }
    }
  },
  "$defs": {
    "secretName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "secretKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[0-9a-f]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 30000,
          "maximum": 32767
        }
      }
    }
  }
}
