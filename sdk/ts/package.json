{
  "name": "@hull/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Hull apps: local user-token verification, permissions, row-level-secured db access, flows, and streaming agents against a Hull Broker.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./browser": "./dist/src/browser.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test dist/test"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
